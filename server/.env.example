# 复制为 .env 后填写真实值。
# 代码里不再提供默认值，缺少任何一项都会在启动时报错。

# ===== 应用 =====
APP_APP_NAME=on-my-agent-server
APP_APP_VERSION=0.1.0
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000
APP_API_V1_PREFIX=/api/v1

# ===== 跨域：JSON 数组 =====
APP_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ===== 日志 =====
APP_LOG_LEVEL=INFO
APP_LOG_DIR=logs
APP_LOG_MAX_BYTES=10485760
APP_LOG_BACKUP_COUNT=7

# ===== 数据库 =====
# 密码里的 @ : % 等字符需要 URL 编码
APP_DATABASE_URL=mysql+aiomysql://oma:change_me@127.0.0.1:3306/oh_my_agent?charset=utf8mb4

# ===== JWT =====
# 生成命令：
# .venv/Scripts/python.exe -c "import secrets; print(secrets.token_urlsafe(48))"
APP_JWT_SECRET=change_me
APP_JWT_EXPIRE_MINUTES=10080

# ===== API KEY 加密 =====
# Base64 编码的 32 字节，生成命令：
# .venv/Scripts/python.exe -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
APP_AES_KEY=change_me

# ===== 管理员：JSON 数组 =====
APP_ADMIN_USERNAMES=["admin"]

# ===== 工作区与技能 =====
# 相对路径以 server/ 为基准
APP_WORKSPACE_ROOT=../workspace
APP_SKILL_ROOT=../skills

# ===== 运行限制 =====
APP_MAX_UPLOAD_SIZE=52428800
APP_LLM_TIMEOUT=60
APP_SKILL_TIMEOUT=60
APP_AGENT_MAX_TURNS=8
